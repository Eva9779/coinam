
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Root user document: Only the authenticated owner can access their own profile.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Sub-collections: Owners have full access to their own assets and transactions.
      match /assets/{assetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /transactions/{txId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
