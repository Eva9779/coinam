
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Universal Owner-Authorization: Users have full access to their own silo and all nested data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Explicitly allow all sub-collections (assets, transactions, etc.) for the authenticated owner.
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
