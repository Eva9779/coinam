
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Universal Owner-Authorization: Users have full access to their own silo and all nested data.
    // This recursive match ensures all sub-collections (assets, transactions, logs) are authorized.
    match /users/{userId}/{allSubcollections=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Explicit match for the root user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
