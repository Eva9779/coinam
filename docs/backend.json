
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Root identity document. Access is strictly controlled to the authenticated owner (UID match).",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "updatedAt": { "type": "string" },
        "totalBotEarnings": { "type": "number" },
        "botActive": { "type": "boolean" },
        "botAllocation": { "type": "number" },
        "botRiskLevel": { "type": "string", "enum": ["low", "medium", "high"] },
        "botStrategy": { "type": "string", "enum": ["standard", "bitcoin_multiplier"] },
        "stockBotActive": { "type": "boolean" },
        "stockBotRisk": { "type": "string", "enum": ["low", "medium", "high"] }
      },
      "required": ["uid", "email"]
    },
    "WalletAsset": {
      "title": "Wallet Asset",
      "description": "Cryptographic vault document.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "currency": { "type": "string" },
        "amount": { "type": "number" },
        "fiatValueUSD": { "type": "number" },
        "address": { "type": "string" },
        "isLive": { "type": "boolean" },
        "privateKey": { "type": "string" }
      },
      "required": ["currency", "address"]
    },
    "StockAsset": {
      "title": "Stock Asset",
      "description": "Tokenized Real World Asset (RWA) representing traditional equity or bonds on-chain.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "symbol": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["stock", "bond"] },
        "shares": { "type": "number" },
        "currentPrice": { "type": "number" },
        "totalValue": { "type": "number" },
        "tokenAddress": { "type": "string", "description": "The ERC-20 contract address for the tokenized asset." }
      },
      "required": ["symbol", "name", "shares"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Private financial ledger.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["send", "receive", "trade"] },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "hash": { "type": "string" },
        "currency": { "type": "string" },
        "amount": { "type": "number" },
        "fiatValueUSD": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "toAddress": { "type": "string" },
        "fromAddress": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["type", "currency", "amount", "timestamp"]
    }
  },
  "auth": {
    "providers": ["email/password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Root user identity."
    },
    "/users/{userId}/assets/{assetId}": {
      "schema": "WalletAsset",
      "description": "Individual vault endpoints."
    },
    "/users/{userId}/stocks/{stockId}": {
      "schema": "StockAsset",
      "description": "Tokenized RWA holdings (Stocks and Bonds)."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Private financial ledger."
    }
  }
}
