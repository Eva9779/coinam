
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Root identity document for all account sub-collections. Owners have full read/write access.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "WalletAsset": {
      "title": "Wallet Asset",
      "description": "Cryptographic vault document. The 'primary-vault' ID is used for the deterministic root wallet. Owners have full read/write access.",
      "type": "object",
      "properties": {
        "currency": { "type": "string" },
        "amount": { "type": "number" },
        "fiatValueUSD": { "type": "number" },
        "address": { "type": "string" },
        "isLive": { "type": "boolean" },
        "privateKey": { "type": "string" }
      },
      "required": ["currency", "address"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Ledger entry for financial activity. Owners have read and create access.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["send", "receive", "trade"] },
        "currency": { "type": "string" },
        "amount": { "type": "number" },
        "fiatValueUSD": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "toAddress": { "type": "string" },
        "fromAddress": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["type", "currency", "amount", "timestamp"]
    }
  },
  "auth": {
    "providers": ["email/password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Root user profile."
    },
    "/users/{userId}/assets/{assetId}": {
      "schema": "WalletAsset",
      "description": "Individual wallet keys and balances."
    },
    "/users/{userId}/transactions/{txId}": {
      "schema": "Transaction",
      "description": "Historical transaction ledger."
    }
  }
}
