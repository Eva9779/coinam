{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Root identity document. Access is strictly controlled to the authenticated owner (UID match).",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "updatedAt": { "type": "string" },
        "totalBotEarnings": { "type": "number" },
        "botActive": { "type": "boolean" },
        "botAllocation": { "type": "number" },
        "botRiskLevel": { "type": "string", "enum": ["low", "medium", "high"] },
        "botStrategy": { "type": "string", "enum": ["standard", "bitcoin_multiplier"] },
        "cryptoPositions": { "type": "array", "items": { "type": "object" } },
        "baselinePrices": { "type": "object" },
        "botLogs": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "msg": { "type": "string" },
              "type": { "type": "string" },
              "timestamp": { "type": "string" }
            }
          } 
        }
      },
      "required": ["uid", "email"]
    },
    "WalletAsset": {
      "title": "Wallet Asset",
      "description": "Cryptographic vault document.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "currency": { "type": "string" },
        "amount": { "type": "number" },
        "fiatValueUSD": { "type": "number" },
        "address": { "type": "string" },
        "isLive": { "type": "boolean" },
        "privateKey": { "type": "string" }
      },
      "required": ["currency", "address"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Private financial ledger.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["send", "receive", "trade"] },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "hash": { "type": "string" },
        "currency": { "type": "string" },
        "amount": { "type": "number" },
        "fiatValueUSD": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "toAddress": { "type": "string" },
        "fromAddress": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["type", "currency", "amount", "timestamp"]
    },
    "BotState": {
      "title": "Bot State",
      "description": "Global strategy parameters and execution state.",
      "type": "object",
      "properties": {
        "isActive": { "type": "boolean" },
        "targetAsset": { "type": "string", "enum": ["ETH", "BTC", "SOL"] },
        "holding": { "type": "string" },
        "lastReferencePrice": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["email/password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Root user identity."
    },
    "/users/{userId}/assets/{assetId}": {
      "schema": "WalletAsset",
      "description": "Individual vault endpoints."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Private financial ledger."
    },
    "/botState/{stateId}": {
      "schema": "BotState",
      "description": "Global strategy parameters."
    }
  }
}